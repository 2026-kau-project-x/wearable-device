#include <Arduino.h>

// 명령:
// 0x01 중지 / 0x02 엄지 / 0x03 검지
// 0x04 소지 / 0x05 약지
// 0x06 순차 패턴 / 0x07 전체 동시 진동
//
// 반환: 정상 실행 true / 잘못된 명령 false
bool runFingerMotor(uint8_t command) {
  if (command < 0x01 || command > 0x07) {
    return false;
  }

  // 배열 순서: 엄지, 검지, 중지, 약지, 소지
  const uint8_t pins[5] = {18, 19, 21, 22, 23};

  const uint8_t onLevel  = HIGH;
  const uint8_t offLevel = LOW;

  const uint32_t vibrationMs = 200;
  const uint32_t sequenceIntervalMs = 500;

  // 출력 설정 및 전체 OFF
  for (uint8_t i = 0; i < 5; ++i) {
    digitalWrite(pins[i], offLevel);
    pinMode(pins[i], OUTPUT);
    digitalWrite(pins[i], offLevel);
  }

  // 한 모터를 진동시키고 자동 정지
  auto pulseMotor = [&](uint8_t index) {
    digitalWrite(pins[index], onLevel);
    delay(vibrationMs);
    digitalWrite(pins[index], offLevel);
  };

  switch (command) {
    case 0x01:
      pulseMotor(2);  // 중지
      break;

    case 0x02:
      pulseMotor(0);  // 엄지
      break;

    case 0x03:
      pulseMotor(1);  // 검지
      break;

    case 0x04:
      pulseMotor(4);  // 소지
      break;

    case 0x05:
      pulseMotor(3);  // 약지
      break;

    case 0x06:
      // 엄지 → 검지 → 중지 → 약지 → 소지
      for (uint8_t i = 0; i < 5; ++i) {
        pulseMotor(i);

        if (i < 4) {
          delay(sequenceIntervalMs - vibrationMs);
        }
      }
      break;

    case 0x07:
      for (uint8_t i = 0; i < 5; ++i) {
        digitalWrite(pins[i], onLevel);
      }

      delay(vibrationMs);

      for (uint8_t i = 0; i < 5; ++i) {
        digitalWrite(pins[i], offLevel);
      }
      break;
  }

  return true;
}

//test
void setup() {
  Serial.begin(115200);
  Serial.println("명령 입력: 1~7");
}

void loop() {
  if (Serial.available() > 0) {
    const char input = Serial.read();

    // 줄바꿈은 무시
    if (input == '\r' || input == '\n') {
      return;
    }

    if (input < '1' || input > '7') {
      Serial.println("오류: 1~7을 입력하세요.");
      return;
    }

    // 문자 '2'를 명령값 0x02로 변환
    const uint8_t command = input - '0';

    Serial.printf("실행: 0x%02X\n", command);

    const bool result = runFingerMotor(command);

    Serial.println(result ? "동작 완료" : "잘못된 명령");
  }
}
